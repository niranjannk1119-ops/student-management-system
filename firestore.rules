rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == "Kbh5nTxWNgf2ObLIXfGhJ5O4YfG3";
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function approvedStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).role == "student" &&
        userDoc(request.auth.uid).status == "approved";
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(["name","email","role","status","createdAt"]) &&
        request.resource.data.role == "student" &&
        request.resource.data.status == "pending" &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
      allow delete: if isAdmin();
    }

    match /materials/{id} {
      allow read: if isAdmin() || approvedStudent();
      allow create, update, delete: if isAdmin();
    }

    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(["uid","name","email","lastSeen"]);
      allow read: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /loginHistory/{id} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["uid","email","at"]);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // One private conversation document per student.
    match /conversations/{studentUid} {
      allow read: if isAdmin() || (approvedStudent() && request.auth.uid == studentUid);
      allow create: if approvedStudent() && request.auth.uid == studentUid &&
        request.resource.data.keys().hasOnly([
          "studentUid","studentName","studentEmail","lastMessage","lastSenderRole","updatedAt"
        ]) &&
        request.resource.data.studentUid == studentUid &&
        request.resource.data.lastSenderRole == "student" &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() <= 2000;
      allow update: if isAdmin() ||
        (approvedStudent() && request.auth.uid == studentUid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "studentUid","studentName","studentEmail","lastMessage","lastSenderRole","updatedAt"
         ]) &&
         request.resource.data.studentUid == studentUid &&
         request.resource.data.lastSenderRole == "student" &&
         request.resource.data.lastMessage is string &&
         request.resource.data.lastMessage.size() <= 2000);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (approvedStudent() && request.auth.uid == studentUid);

        allow create: if
          request.resource.data.keys().hasOnly([
            "text","senderUid","senderRole","createdAt","readByAdmin","readByStudent"
          ]) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.readByAdmin == false &&
          request.resource.data.readByStudent == false &&
          (
            (approvedStudent() &&
             request.auth.uid == studentUid &&
             request.resource.data.senderUid == request.auth.uid &&
             request.resource.data.senderRole == "student")
            ||
            (isAdmin() &&
             request.resource.data.senderUid == request.auth.uid &&
             request.resource.data.senderRole == "admin")
          );

        // Admin alone marks a student's message as read.
        // The student can mark an admin reply as read; only admin UI displays the blue tick.
        allow update: if
          (isAdmin() &&
           resource.data.senderRole == "student" &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByAdmin"]) &&
           request.resource.data.readByAdmin == true)
          ||
          (approvedStudent() &&
           request.auth.uid == studentUid &&
           resource.data.senderRole == "admin" &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByStudent"]) &&
           request.resource.data.readByStudent == true);

        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
