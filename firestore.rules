rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == "Kbh5nTxWNgf2ObLIXfGhJ5O4YfG3";
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function approvedStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).role == "student" &&
        userDoc(request.auth.uid).status == "approved";
    }
    function ownsConversation(studentUid) {
      return approvedStudent() && request.auth.uid == studentUid;
    }
    function validMessageText() {
      return request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
    }

    // Existing user permissions — preserved.
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(["name","email","role","status","createdAt"]) &&
        request.resource.data.role == "student" &&
        request.resource.data.status == "pending" &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
      allow delete: if isAdmin();
    }

    // Existing study-material permissions — preserved.
    match /materials/{id} {
      allow read: if isAdmin() || approvedStudent();
      allow create, update, delete: if isAdmin();
    }

    // Existing student-presence permissions — preserved.
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(["uid","name","email","lastSeen"]);
      allow read: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Existing login-history permissions — preserved.
    match /loginHistory/{id} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["uid","email","at"]);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Ask the Admin: one conversation document per student.
    // Suggested path: conversations/{studentUid}
    match /conversations/{studentUid} {
      allow create: if ownsConversation(studentUid) &&
        request.resource.data.keys().hasOnly(["studentUid","studentName","studentEmail","createdAt","updatedAt"]) &&
        request.resource.data.studentUid == studentUid &&
        request.resource.data.studentName is string &&
        request.resource.data.studentEmail == request.auth.token.email;
      allow read: if isAdmin() || ownsConversation(studentUid);
      allow update: if isAdmin() ||
        (ownsConversation(studentUid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt"]));
      allow delete: if isAdmin();

      // Messages are immutable after sending; read receipts are stored separately
      // so students cannot read admin-only blue-tick information.
      match /messages/{messageId} {
        allow read: if isAdmin() || ownsConversation(studentUid);
        allow create: if (
          ownsConversation(studentUid) &&
          request.resource.data.keys().hasOnly(["senderUid","senderRole","text","createdAt"]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderRole == "student" &&
          validMessageText()
        ) || (
          isAdmin() &&
          request.resource.data.keys().hasOnly(["senderUid","senderRole","text","createdAt"]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderRole == "admin" &&
          validMessageText() &&
          exists(/databases/$(database)/documents/conversations/$(studentUid))
        );
        allow update, delete: if false;
      }

      // Admin-only receipt records. A student may create a receipt only for an
      // admin message; the admin may create one for a student message.
      // Only the admin can read these records, so students never receive blue ticks.
      match /adminReceipts/{messageId} {
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(["messageId","readerUid","readerRole","readAt"]) &&
          request.resource.data.messageId == messageId &&
          request.resource.data.readAt is timestamp &&
          ((isAdmin() &&
            request.resource.data.readerUid == request.auth.uid &&
            request.resource.data.readerRole == "admin") ||
           (ownsConversation(studentUid) &&
            request.resource.data.readerUid == request.auth.uid &&
            request.resource.data.readerRole == "student" &&
            get(/databases/$(database)/documents/conversations/$(studentUid)/messages/$(messageId)).data.senderRole == "admin"));
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
