rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        "qeHYqJolAaO38gunIgBk8bv2lB93",
        "Kbh5nTxWNgf2ObLIXfGhJ5O4YfG3"
      ];
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    function approvedStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).role == "student" &&
        userDoc(request.auth.uid).status == "approved";
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(["name","phone","email","role","status","createdAt"]) &&
        request.resource.data.role == "student" &&
        request.resource.data.status == "pending" &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
      allow delete: if isAdmin();
    }
    match /materials/{id} {
      allow read: if isAdmin() || approvedStudent();
      allow create, update, delete: if isAdmin();
    }
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(["uid","name","email","lastSeen"]);
      allow read: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    match /loginHistory/{id} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(["uid","email","at"]);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}